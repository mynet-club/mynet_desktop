#!/bin/sh
# preinstall — pkg 安装前跑（升级/重装时先停旧服务）。
#
# 不停的话：mynetd 正在被占用 → 装到一半失败；或 bootstrap 时报
# "service already loaded"。失败**不阻断安装**（首次安装本来就没有服务）。
#
# 两个 label 都要停：legacy `club.mynet.mynetd`（旧版 pkg 自装的）与
# `com.mynet.mynetd`（`mynet install` 写的）。迁移期两者可能并存。
set -u

for LABEL in club.mynet.mynetd com.mynet.mynetd; do
  launchctl bootout "system/${LABEL}" 2>/dev/null || true
  launchctl unload "/Library/LaunchDaemons/${LABEL}.plist" 2>/dev/null || true
done

exit 0
