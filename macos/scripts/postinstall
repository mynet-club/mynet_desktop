#!/bin/sh
# postinstall — 文件已由 pkg 落地；**服务装配全部委托 `mynet install`**。
#
# 为什么不再自己写 launchd：系统能力（plist / env / detector / enable）只归执行器
# （mynet / mynetd）。pkg 是薄壳 —— 即合同 §1「系统登记只有一个 owner：mynet install」。
# 旧版曾在 payload 里塞 club.mynet.mynetd.plist 并自行 bootstrap；现统一由
# `mynet install` 写 com.mynet.mynetd.plist，旧 label 在本步清除（迁移）。
#
# 布局：PREFIX=/opt/mynet，HOME=/var/lib/mynet。
# 缺 mynetd 必须失败 —— 静默装空壳是 V2-9 同源教训。
set -u

PREFIX=/opt/mynet
MYNET_HOME=/var/lib/mynet
LEGACY_LABEL=club.mynet.mynetd
LEGACY_PLIST=/Library/LaunchDaemons/${LEGACY_LABEL}.plist
BIN=$PREFIX/bin/mynetd
GW_DEFAULT='wss://gw.mynet.club/v1/node/connect'

if [ ! -x "$BIN" ]; then
  echo "postinstall: 缺 $BIN —— 产物没落全，拒绝装配" >&2
  exit 1
fi

install -d -m 0755 /var/log/mynet
install -d -m 0700 "$MYNET_HOME/conf" "$MYNET_HOME/var"
chown -R root:wheel "$PREFIX" "$MYNET_HOME" /var/log/mynet 2>/dev/null || true

# 迁移：清掉旧版 pkg 自装的 legacy label/plist，避免双 daemon
launchctl bootout "system/${LEGACY_LABEL}" 2>/dev/null || true
rm -f "$LEGACY_PLIST"

# gateways 解析顺序（升级不换网络入口）
GW=""
if [ -f "$PREFIX/etc/mynetd.env" ]; then
  GW=$(sed -n 's/^MYNET_GATEWAYS=//p' "$PREFIX/etc/mynetd.env" | head -1)
fi
if [ -z "$GW" ] && [ -f /Library/LaunchDaemons/com.mynet.mynetd.plist ]; then
  GW=$(/usr/libexec/PlistBuddy -c 'Print :EnvironmentVariables:MYNET_GATEWAYS' \
        /Library/LaunchDaemons/com.mynet.mynetd.plist 2>/dev/null || true)
fi
[ -n "$GW" ] || GW="$GW_DEFAULT"

export MYNET_HOME
"$PREFIX/bin/mynet" install --gateways "$GW" --prefix "$PREFIX" --home "$MYNET_HOME"
rc=$?
if [ $rc -ne 0 ]; then
  # 不静默：文件已落地、服务没装配成功，让用户看到确切补救命令
  echo "文件已安装，但服务装配失败（rc=$rc）。请手动执行：" >&2
  echo "  sudo MYNET_HOME=$MYNET_HOME $PREFIX/bin/mynet install --gateways '$GW' --prefix $PREFIX --home $MYNET_HOME" >&2
  exit $rc
fi

# 装完即引导：等 mynetd 的 WebUI 就绪（bootstrap 到监听有几秒间隙），
# 再以控制台用户打开浏览器 —— root 直接 open 会开到错的会话/根本不开。
# 打不开不算安装失败（托盘已在菜单栏/应用程序里）。
n=0
while [ $n -lt 12 ]; do
  curl -sf -o /dev/null http://127.0.0.1:8096/ui/ && break
  n=$((n+1))
  sleep 2
done
CU=$(stat -f%Su /dev/console)
if [ -n "$CU" ] && [ "$CU" != root ]; then
  su "$CU" -c 'open http://127.0.0.1:8096/ui/' 2>/dev/null || true
fi

if [ -x "$PREFIX/bin/mynet_tray" ]; then
  echo "postinstall: 托盘在 $PREFIX/bin/mynet_tray（MyNet.app 已在应用程序/启动台）"
fi
echo "postinstall: 服务由 mynet install 装配（label com.mynet.mynetd，log: /var/log/mynet/mynetd.log）"
exit 0
